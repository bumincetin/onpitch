# ---------------------------------------------------------------------------
# services/anomaly — sidecar environment
#
#   cp .env.example .env      # then fill in the secrets
#
# This file configures the PYTHON SIDECAR ONLY. The Next.js app has its own
# .env at the repository root; the one value that must be byte-identical in
# both is ANOMALY_SERVICE_SECRET.
#
# Nothing here is read automatically — the service reads the process
# environment. Export it yourself (`set -a; . ./.env; set +a`), let Docker
# Compose do it (`env_file:`), or pass -e flags to `docker run`.
# ---------------------------------------------------------------------------

# --- Authentication (required) ---------------------------------------------

# Shared HMAC key. MUST equal ANOMALY_SERVICE_SECRET in the app's .env, or
# every request is rejected with 401 signature_invalid. At least 32 chars.
#   openssl rand -hex 32
ANOMALY_SERVICE_SECRET=replace-me-with-openssl-rand-hex-32

# Local development escape hatch: accept unsigned requests, so anything that can
# reach the port can score. Refused outright when ANOMALY_ENV=production.
# ANOMALY_ALLOW_UNSIGNED=false

# How far a request timestamp may sit from server time, in seconds, in either
# direction. 300 matches the caller.
# ANOMALY_MAX_CLOCK_SKEW_SECONDS=300

# Guards POST /model/reload. Falls back to INTERNAL_API_TOKEN when unset; with
# neither set, the reload endpoint is closed to everyone.
# ANOMALY_ADMIN_TOKEN=replace-me

# --- Model ------------------------------------------------------------------

# Where model.joblib and metadata.json live. Missing directory => the service
# serves the deterministic rule engine and reports modelVersion
# "rules-fallback-v1". That is a supported state; see README §5.
# ANOMALY_MODEL_DIR=artifacts

# Score at or above which a match is flagged for peer consensus. Keep in step
# with public.anomaly_score_threshold() in
# supabase/migrations/0005_integrity_consensus.sql (default 0.62) — the two are
# independent knobs and drifting them apart makes verdicts hard to explain.
# ANOMALY_THRESHOLD=0.62

# Fitting defaults, used by train.py unless overridden on its command line.
# ANOMALY_N_ESTIMATORS=200
# ANOMALY_CONTAMINATION=auto
# ANOMALY_RANDOM_STATE=1712

# --- Transport --------------------------------------------------------------

# CORS allow-list, comma separated. Browsers never call this service (the
# caller is a Next.js route handler), so this is defence in depth.
# ANOMALY_ALLOWED_ORIGINS=http://localhost:3000

# Per-peer sliding window. Counted per process — see app/security.py.
# ANOMALY_RATE_LIMIT=120
# ANOMALY_RATE_LIMIT_WINDOW_SECONDS=60

# Largest accepted /score/batch payload, and the hard body-size cap.
# ANOMALY_MAX_BATCH_SIZE=200
# ANOMALY_MAX_BODY_BYTES=1048576

# --- Runtime ----------------------------------------------------------------

# development | test | production. Production refuses ANOMALY_ALLOW_UNSIGNED.
# ANOMALY_ENV=development
# ANOMALY_LOG_LEVEL=INFO

# --- Training only (train.py --source db) -----------------------------------

# Supavisor SESSION mode, port 5432. NOT the transaction pooler on 6543 — that
# one returns the connection at every COMMIT, which breaks the server-side
# cursor this job streams through. train.py refuses a :6543 URL outright.
# Falls back to DIRECT_URL when unset.
# ANOMALY_TRAINING_DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres

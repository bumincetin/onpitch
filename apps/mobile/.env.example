# apps/mobile/.env.example
#
# Copy to apps/mobile/.env and fill in. Every name here starts with EXPO_PUBLIC_ because Babel
# inlines those into the JavaScript bundle at build time — anyone with the app can read them.
# Nothing secret goes in this file. The Supabase service-role key and the Stripe secret key stay
# on the server, in apps/web/.env.local.
#
# Values are baked into the bundle, so after changing one restart with `npx expo start --clear`.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon key. Public by design: every query it makes is still filtered by RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Origin of the Next.js app that serves /api/**. No trailing slash.
# A phone cannot reach http://localhost:3000 — that resolves to the phone itself. Use your
# machine's LAN address on a device, or http://10.0.2.2:3000 on the Android emulator.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Optional. POST /api/bookings/checkout returns the publishable key alongside the client secret,
# so checkout works without this. Set it to mount StripeProvider at launch instead of on first
# payment, which is what Apple Pay / Google Pay availability checks need.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
